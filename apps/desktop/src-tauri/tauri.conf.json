{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pennel",
  "version": "0.1.0",
  "identifier": "app.pennel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Pennel",
        "url": "index.html?window=workspace",
        "width": 980,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "zoomHotkeysEnabled": false,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Dictation and meeting notes",
    "longDescription": "Hold a key to dictate clean text in any app, and record meetings as transcripts and notes.",
    "resources": {
      "resources/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "resources/nl.lproj/InfoPlist.strings": "nl.lproj/InfoPlist.strings",
      "../src/desktop-ui/LICENSE": "licenses/Forma.txt",
      "../src/desktop-ui/fonts/OFL.txt": "licenses/Inter-OFL.txt"
    },
    "copyright": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "libwebkit2gtk-4.1-0",
          "gstreamer1.0-tools",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav",
          "pulseaudio-utils",
          "x11-utils",
          "wl-clipboard"
        ]
      }
    }
  }
}
